# ServerSentry environment template. Copy to .env.local for local development.
# NEVER commit real values. NEVER prefix secrets with NEXT_PUBLIC_ (that ships them to browsers).

# --- Core -------------------------------------------------------------------
APP_URL=http://localhost:3000
# development | staging | production. In production, launch gates (below) are enforced.
SS_LAUNCH_MODE=development
# Comma-separated list of approved launch gates (see docs/COMPLIANCE.md#launch-gates).
SS_LAUNCH_GATES_APPROVED=

# --- Database (PostgreSQL / Supabase) ---------------------------------------
# Runtime connection: least-privilege role serversentry_app (RLS enforced). Use TLS in production.
DATABASE_URL=postgres://serversentry_app:CHANGE_ME@localhost:5432/serversentry
# Owner connection used ONLY by migration/maintenance scripts. Never set this in Vercel.
DATABASE_ADMIN_URL=postgres://postgres@localhost:5432/serversentry
# Local only: let `npm run db:migrate` set the app role's password.
APP_DB_PASSWORD=CHANGE_ME
SS_SET_APP_ROLE_PASSWORD=true

# --- Secrets (generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))") ---
APP_ENCRYPTION_KEY=
APP_HMAC_SECRET=

# --- WebAuthn / passkeys ----------------------------------------------------
# Defaults to APP_URL hostname. Must match the domain users visit.
WEBAUTHN_RP_ID=
# Require passkey-verified sessions for admin & super_admin (recommended: true)
ADMIN_REQUIRE_PASSKEY=true

# --- Reporting safeguards ----------------------------------------------------
REPORT_MIN_ACCOUNT_AGE_HOURS=24

# --- Stripe (ServerSentry Plus £0.99/month) ---------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PLUS_MONTHLY=

# --- Evidence storage -------------------------------------------------------
# local (dev only, private directory outside /public) | supabase (private bucket, signed URLs)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage
SUPABASE_URL=
# SERVER ONLY. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_EVIDENCE_BUCKET=evidence

# --- Email (Resend HTTP API). Without a key, emails are printed to the server console in development only.
RESEND_API_KEY=
EMAIL_FROM=ServerSentry <no-reply@example.com>

# --- Scheduled jobs (Vercel Cron sends Authorization: Bearer $CRON_SECRET) ---
CRON_SECRET=

# --- Automatic account verification via Discord connections (PlayStation, Xbox, Riot, Battle.net, Epic, Steam)
# Create an app at https://discord.com/developers/applications → OAuth2 → add redirect APP_URL/api/identity/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Battle.net official sign-in (BattleTag verification). Register at https://develop.battle.net → redirect APP_URL/api/identity/battlenet/callback
BATTLENET_CLIENT_ID=
BATTLENET_CLIENT_SECRET=

# --- Optional: Steam Web API key (only used to fetch the public persona name after OpenID verification)
STEAM_WEB_API_KEY=

# --- Network / proxy -----------------------------------------------------------
# Header containing the real client IP, ONLY if set by a proxy you control. On Vercel leave empty (auto).
TRUSTED_IP_HEADER=

# --- Development only ------------------------------------------------------------
# Append outgoing emails as JSON lines to this file when RESEND_API_KEY is unset (never in production).
DEV_EMAIL_OUTBOX=

# --- Legal operator details (L-01). Public information shown on Terms, Privacy and Complaints. Required before launch.
OPERATOR_LEGAL_NAME=
OPERATOR_COMPANY_NUMBER=
OPERATOR_ADDRESS=
CONTACT_EMAIL=
PRIVACY_EMAIL=
COMPLAINTS_EMAIL=
ICO_REGISTRATION_NUMBER=
