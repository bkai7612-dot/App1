{
  "name": "serversentry",
  "version": "0.1.0",
  "private": true,
  "description": "ServerSentry - community-powered gaming reputation network",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node scripts/migrate.mjs",
